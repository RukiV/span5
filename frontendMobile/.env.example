# Maak 'n kopie van hierdie lêer as `.env` en pas die waardes vir jou masjien aan.
# `.env` word nie gecommit nie.

# Microsoft OAuth (gedeelde akademie-app-waardes; dieselfde verstek as lib/core/auth_config.dart)
# Gebruik die WEB-frontend se Azure-app (dieselfde client ID as frontend/.env).
# Registreer hierdie redirect URI in Azure: Authentication -> Add platform ->
# "Mobile and desktop applications" -> msauth://com.fbs.akademiafbs/+34jsPvrOFoH3Nt1TvORlteS4Dc=
AZURE_CLIENT_ID=fa4d2b7e-81cf-4970-843a-5894c7083fc0
AZURE_REDIRECT_URI=msauth://com.fbs.akademiafbs/+34jsPvrOFoH3Nt1TvORlteS4Dc=
AZURE_SCOPES=openid,profile,email,User.Read,Calendars.ReadWrite,offline_access

# Vervang met jou ontwikkelmasjien se IP sodat die toestel/emulator die
# backend kan bereik (bv. http://192.168.x.x:8000/api/v1).
# Vir die Android-emulator: http://10.0.2.2:8000/api/v1
#
# Voorrang: --dart-define=API_URL=... > hierdie .env API_URL > hardgekodeerde
# kampus-WiFi-verstek in lib/core/api_client.dart (http://10.12.0.128:8000/api/v1).
API_URL=http://127.0.0.1:8000/api/v1
