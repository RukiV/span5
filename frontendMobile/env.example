# --- BACKEND KONFIGURASIE ---
# Die IP-adres van jou laptop of bediener op die WiFi netwerk.
# Gebruik '10.0.2.2' vir Android Emulator of die fisiese IP vir toestelle.
BACKEND_IP=192.168.1.95
BACKEND_PORT=8000

# --- MICROSOFT AZURE / OUTLOOK AUTH ---
# Hierdie waardes word in die Azure Portal gekry onder 'App Registrations'.
# Maak seker die Redirect URI stem ooreen met die een wat in Azure geregistreer is.
AZURE_TENANT_ID=49c8f005-73ef-462e-99e7-7be3a22980eb
AZURE_CLIENT_ID=ee909cd4-2fae-4cd2-8d7e-da7e8508d772
AZURE_SCOPE=openid profile offline_access User.Read
AZURE_REDIRECT_URI=msauth://com.example.untitled/xc13Rb9XZfaL0EqEJWzx78ijaeM=

# --- GOOGLE MAPS API ---
# Vereis vir die kaart-funksionaliteit op die foon.
# Kry dit by die Google Cloud Console (https://console.cloud.google.com/).
GOOGLE_MAPS_API_KEY_ANDROID=jou_google_maps_sleutel_hier
GOOGLE_MAPS_API_KEY_IOS=jou_google_maps_sleutel_hier

# --- NOTA VIR MENTOR ---
# Hierdie lêer is slegs 'n voorbeeld. Vir sekuriteit moet die regte .env lêer
# nooit na git gepush word nie. In Flutter kan hierdie waardes via
# '--dart-define' of 'flutter_dotenv' gebruik word.
