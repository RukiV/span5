REACT_APP_MICROSOFT_CLIENT_ID=fa4d2b7e-81cf-4970-843a-5894c7083fc0

# --- Authentication ---------------------------------------------------------
# Signing key for session tokens. REQUIRED in any non-development environment:
# the app refuses to start if this is unset (or left as the known default) while
# ENVIRONMENT is not one of development/dev/local/test/testing. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# Deployment environment. Controls the AUTH_SECRET_KEY fail-fast above.
# Use "production" (or anything not in development/dev/local/test/testing) in prod.
ENVIRONMENT=development

# Optional: session lifetime in seconds (default 7200 = 2 hours).
# SESSION_DURATION_SECONDS=7200

# Gmail SMTP vir e-pos herinneringe
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com
REMINDER_CHECK_INTERVAL=60

# AI Analytics — OpenAI API key (opsioneel; sonder dit werk reël-gebaseerde insigte)
# OPENAI_API_KEY=sk-your-key-here

